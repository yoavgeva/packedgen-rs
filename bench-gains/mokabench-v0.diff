+/// Whether `MOKABENCH_CACHES`, a comma-separated list, names `cache`; all
+/// caches run when it is unset.
+fn run_cache(cache: &str) -> bool {
+    std::env::var("MOKABENCH_CACHES").map_or(true, |list| list.split(',').any(|c| c.trim() == cache))
+}

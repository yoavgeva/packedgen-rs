+    config: &Config,
+    capacity: usize,
+    num_clients: u16,
+) -> anyhow::Result<Report> {
+    let cache_driver = PackedGenCache::new(config, capacity);
+    let report_builder =
+        ReportBuilder::new("PackedGen ShardedCache", capacity as _, Some(num_clients));
+    run_multi_threads(config, num_clients, cache_driver, report_builder)
+}
